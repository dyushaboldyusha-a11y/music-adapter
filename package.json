{
  "name": "music-adapter",
  "version": "0.3.0",
  "description": "Liberty — музыкальный виджет для приложений и браузеров",
  "author": "music-adapter",
  "license": "MIT",
  "private": true,
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "demo": "electron . --demo",
    "test": "node --test --test-isolation=none test/*.test.cjs",
    "test:gui": "node scripts/smoke-gui.mjs",
    "test:browser": "node scripts/smoke-browser.mjs",
    "check:windows": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/check-windows.ps1",
    "dist:win": "electron-builder --win portable --x64",
    "pack:win": "electron-builder --win --dir --x64"
  },
  "devDependencies": {
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "playwright": "1.64.1"
  },
  "build": {
    "appId": "io.musicadapter.widget",
    "productName": "Music Adapter",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "browser-extension/services.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "native",
        "to": "native",
        "filter": [
          "**/*.ps1"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false,
      "artifactName": "Music-Adapter-${version}-Windows.${ext}"
    }
  }
}
