{
  "name": "liberty-wave",
  "productName": "Liberty Wave",
  "version": "0.7.1",
  "description": "Liberty Wave — музыкальный виджет для приложений и браузеров",
  "author": "Liberty",
  "license": "MIT",
  "private": true,
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "demo": "electron . --demo",
    "test": "node --test --test-isolation=none test/*.test.cjs",
    "test:gui": "node scripts/smoke-gui.mjs",
    "test:settings": "node scripts/smoke-settings.mjs",
    "test:browser": "node scripts/smoke-browser.mjs",
    "check:windows": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/check-windows.ps1",
    "check:branding": "node scripts/check-branding.cjs",
    "dist:win": "electron-builder --win portable --x64",
    "pack:win": "electron-builder --win --dir --x64",
    "test:features": "node scripts/smoke-features.mjs",
    "test:playback": "node scripts/smoke-playback.mjs",
    "test:glass": "node scripts/smoke-glass.mjs",
    "test:glass-fixes": "node scripts/smoke-glass-fixes.mjs",
    "test:visual-audit": "node scripts/smoke-visual-audit.mjs",
    "test:glass-polish": "node scripts/smoke-glass-polish.mjs",
    "test:widget-visual": "node scripts/smoke-widget-visual.mjs",
    "test:control": "node scripts/smoke-control.mjs",
    "test:update-network": "electron scripts/check-update-network.cjs",
    "test:personalization": "node scripts/smoke-personalization.mjs",
    "test:tab-wave": "node scripts/smoke-tab-wave.mjs",
    "test:wave-fixes": "node scripts/smoke-wave-fixes.mjs",
    "test:startup": "node scripts/smoke-startup.mjs",
    "test:automation": "node scripts/smoke-automation.mjs",
    "test:installer-survival": "node scripts/check-installer-survival.cjs",
    "test:music-effects": "node scripts/smoke-music-effects.mjs",
    "voice:prepare": "node --use-env-proxy scripts/prepare-voice.cjs",
    "predist:win": "npm run voice:prepare",
    "prepack:win": "npm run voice:prepare",
    "test:voice": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File native/windows-automation.ps1 -CheckSamples test/fixtures/voice"
  },
  "devDependencies": {
    "@electron-internal/extract-zip": "1.0.8",
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "playwright": "1.64.1",
    "resedit": "1.7.2"
  },
  "build": {
    "appId": "io.musicadapter.widget",
    "productName": "Liberty Wave",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "browser-extension/services.js",
      "browser-extension/playback-fade.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "native",
        "to": "native",
        "filter": [
          "**/*.ps1",
          "**/*.cs"
        ]
      },
      {
        "from": "artifacts/voice-runtime",
        "to": "native/voice",
        "filter": [
          "**/*",
          "!linux-x64/**"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signExecutable": false,
      "artifactName": "Liberty-Wave-${version}-Windows.${ext}"
    }
  }
}
